     void testNameForCode()
     {
         // This is somewhat wrong, it should not say US.
-        QCOMPARE(KLanguageName::nameForCode("en"), "US English");
+        // Qt 6.12 ships newer CLDR data where the display name of "en"
+        // is "English" instead of "US English"; accept both.
+        const QString enName = KLanguageName::nameForCode("en");
+        QVERIFY2(enName == QLatin1String("US English") || enName == QLatin1String("English"),
+                 qPrintable(QStringLiteral("unexpected name for 'en': ") + enName));
 
         QCOMPARE(KLanguageName::nameForCode("de"), "German");
         QCOMPARE(KLanguageName::nameForCode("pt"), "Portuguese");
